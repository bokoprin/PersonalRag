<Window x:Class="PersonalRag.FilenameSearch.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PersonalRag · Filename Search" Width="1180" Height="720" MinWidth="780" MinHeight="420"
        FontFamily="Segoe UI, Yu Gothic UI" FontSize="13" Background="White"
        Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnGlobalKey">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="9,3"/><Setter Property="Margin" Value="4,0,0,0"/></Style>
    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="3"/></Style>
    <Style TargetType="GridViewColumnHeader"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="6,3"/></Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#FBFBFB" BorderBrush="#D4D4D4" BorderThickness="0,0,0,1" Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="185"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="5"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <TextBlock Text="ファイル名 / パス" VerticalAlignment="Center"/>
        <TextBox x:Name="FileQuery" Grid.Column="1" AutomationProperties.AutomationId="filenameQuery" TextChanged="QueryChanged"/>
        <ComboBox x:Name="Scope" Grid.Column="2" SelectedIndex="0" Margin="8,0" VerticalContentAlignment="Center" SelectionChanged="QueryChanged">
          <ComboBoxItem Content="ファイル名"/><ComboBoxItem Content="フルパス"/>
        </ComboBox>
        <CheckBox x:Name="CaseSensitive" Grid.Column="3" Content="大文字/小文字を区別" VerticalAlignment="Center" Checked="QueryChanged" Unchecked="QueryChanged"/>
        <TextBlock Grid.Row="2" Text="内容" VerticalAlignment="Center"/>
        <TextBox x:Name="ContentQuery" Grid.Row="2" Grid.Column="1" IsEnabled="False" Text="内容検索は次フェーズ" Foreground="#777"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="Filename phase: 内容検索は無効" Foreground="#777" VerticalAlignment="Center" Margin="8,0"/>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Top" BorderBrush="#D4D4D4" BorderThickness="0,0,0,1" Padding="10,5">
      <DockPanel><TextBlock x:Name="Summary" Text="準備中" VerticalAlignment="Center"/></DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#D4D4D4" BorderThickness="0,1,0,0" Padding="10,5">
      <DockPanel><TextBlock DockPanel.Dock="Right" Foreground="#777" Text="Ctrl+F: ファイル検索 / 一覧↑↓: 移動 / Enter: 開く"/><TextBlock x:Name="Status" Text="準備中"/></DockPanel>
    </Border>
    <ListView x:Name="Results" AutomationProperties.AutomationId="results" SelectionChanged="SelectionChanged" PreviewKeyDown="ResultKey" MouseDoubleClick="OpenSelected"
              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <ListView.View><GridView>
        <GridViewColumn Header="Name" Width="250" DisplayMemberBinding="{Binding Name}"/>
        <GridViewColumn Header="Path" Width="610" DisplayMemberBinding="{Binding FullPath}"/>
        <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding Size}"/>
        <GridViewColumn Header="Modified" Width="165" DisplayMemberBinding="{Binding Modified}"/>
      </GridView></ListView.View>
    </ListView>
  </DockPanel>
</Window>
