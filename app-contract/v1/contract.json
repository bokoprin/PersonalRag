{
  "name": "personalrag-app-contract",
  "version": 1,
  "commands": {
    "contract_info": {
      "request": null,
      "response": "ContractInfo"
    },
    "search": {
      "request": "SearchRequest",
      "response": "SearchHit[]"
    },
    "cancel_search": {
      "request": null,
      "response": "void"
    },
    "index": {
      "request": "IndexRequest",
      "response": "IndexResponse"
    },
    "load_settings": {
      "request": null,
      "response": "Settings"
    },
    "set_search_backend": {
      "request": "string",
      "response": "SearchBackendStatus"
    },
    "background_status": {
      "request": null,
      "response": "BackgroundStatus"
    },
    "background_enable": {
      "request": "IndexRequest",
      "response": "BackgroundStatus"
    },
    "background_disable": {
      "request": null,
      "response": "BackgroundStatus"
    },
    "background_sync_now": {
      "request": null,
      "response": "BackgroundStatus"
    },
    "background_rebuild": {
      "request": null,
      "response": "BackgroundStatus"
    },
    "background_cancel": {
      "request": null,
      "response": "BackgroundStatus"
    },
    "snippets": {
      "request": "SnippetRequest",
      "response": "SnippetHit[]"
    },
    "snippets_batch": {
      "request": "SnippetBatchRequest",
      "response": "SnippetBatchResult[]"
    },
    "open_file": {
      "request": "path",
      "response": "void"
    },
    "open_parent": {
      "request": "path",
      "response": "void"
    }
  },
  "dto_fields": {
    "ContractInfo": [
      "name",
      "version",
      "capabilities"
    ],
    "ExclusionConfig": [
      "dev_caches",
      "virtual_envs",
      "node_modules",
      "build_artifacts",
      "vcs",
      "use_gitignore",
      "custom_directory_names",
      "custom_relative_paths",
      "custom_globs"
    ],
    "Settings": [
      "roots",
      "max_bytes",
      "background_enabled",
      "search_backend",
      "scanner_mode",
      "exclusions"
    ],
    "SearchRequest": [
      "file_query",
      "include_path",
      "content_query",
      "extensions",
      "path_scope",
      "match_case",
      "whole_words",
      "regex",
      "sort_field",
      "sort_direction",
      "limit"
    ],
    "SearchHit": [
      "file_id",
      "path",
      "name",
      "extension",
      "size_bytes",
      "modified_ns",
      "content_state"
    ],
    "IndexRequest": [
      "roots",
      "maxBytes",
      "scannerMode",
      "exclusions"
    ],
    "SnippetRequest": [
      "path",
      "query",
      "context",
      "maxHits",
      "matchCase",
      "wholeWords",
      "regex"
    ],
    "SnippetHit": [
      "line_number",
      "before",
      "hit_line",
      "after"
    ],
    "SnippetBatchRequest": [
      "items"
    ],
    "SnippetBatchResult": [
      "path",
      "hits"
    ],
    "RebuildProgress": [
      "phase",
      "total_files",
      "processed_files",
      "indexed_files",
      "unchanged_files",
      "skipped_files",
      "error_files",
      "bytes_read",
      "current_path",
      "elapsed_ms",
      "discovered_files",
      "pruned_files",
      "files_per_second",
      "mib_per_second",
      "queue_files",
      "prepared_bytes",
      "remaining_files",
      "eta_ms",
      "estimated_completion_at_ms"
    ],
    "RebuildStatus": [
      "job_id",
      "state",
      "progress",
      "started_at",
      "finished_at",
      "error"
    ],
    "BackgroundStatus": [
      "running",
      "mode",
      "sync_state",
      "pending_changes",
      "last_sync_at",
      "last_error",
      "rebuild"
    ],
    "IndexResponse": [
      "accepted",
      "job_id",
      "state",
      "message",
      "status",
      "settings"
    ],
    "BackendReadiness": [
      "search_v2_ready",
      "state"
    ],
    "SearchBackendStatus": [
      "requested",
      "active",
      "readiness"
    ]
  }
}
