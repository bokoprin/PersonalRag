     #[test]
+    fn full_build_reports_stage_timings_without_profile_environment() {
+        let unique = SystemTime::now()
+            .duration_since(SystemTime::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let root = std::env::temp_dir().join(format!("personalrag-build-timing-{unique}"));
+        let source = root.join("source");
+        let build_dir = root.join("index");
+        fs::create_dir_all(&source).unwrap();
+        fs::write(source.join("a.txt"), b"alpha timeout").unwrap();
+        fs::write(source.join("b.txt"), b"beta marker").unwrap();
+        let files = vec![
+            ScannedFile {
+                path: source.join("a.txt"),
+                display_path: "a.txt".to_owned(),
+                size_bytes: 13,
+                modified_ns: 1,
+                index_content: true,
+            },
+            ScannedFile {
+                path: source.join("b.txt"),
+                display_path: "b.txt".to_owned(),
+                size_bytes: 11,
+                modified_ns: 2,
+                index_content: true,
+            },
+        ];
+        let engine = PortableEngine::default();
+        let outcome = engine
+            .build(
+                &source,
+                files,
+                &build_dir,
+                1024 * 1024,
+                &AtomicBool::new(false),
+                &mut |_| {},
+            )
+            .unwrap();
+        let names = outcome
+            .stage_timings
+            .iter()
+            .map(|timing| timing.name.as_str())
+            .collect::<Vec<_>>();
+        for expected in [
+            "build.sort",
+            "build.prepare_inputs",
+            "build.base_index",
+            "build.verify_base",
+            "build.initialize_generation",
+            "build.verify_generation",
+            "build.office_cache_publish",
+            "build.finalize_outcome",
+            "build.total",
+        ] {
+            assert!(
+                names.contains(&expected),
+                "missing stage timing: {expected}"
+            );
+        }
+        assert!(outcome
+            .stage_timings
+            .iter()
+            .all(|timing| timing.elapsed_ms >= 0.0 && timing.elapsed_ms.is_finite()));
+        fs::remove_dir_all(root).unwrap();
+    }
